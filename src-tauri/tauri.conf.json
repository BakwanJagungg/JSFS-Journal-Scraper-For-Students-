{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSFS",
  "version": "3.0.0",
  "identifier": "id.jsfs.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JSFS v3.0.0 — Journal Scraper For Students",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 660,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
